# Exit node: accepts clients and (with the NAT in docker-compose.server.yml)
# forwards their traffic to the internet. Copy to server.env and fill in.
# Generate keys with:  goproxy keypair   (or genkey | pubkey)

GOPROXY_LISTEN=0.0.0.0:443
GOPROXY_TRANSPORT=tls

# This node's static private key (base64).
GOPROXY_PRIVATE_KEY=REPLACE_WITH_EXIT_PRIVATE_KEY

# Shared secret; must match every client (per peer: GOPROXY_PEER_<NAME>_PSK).
GOPROXY_PSK=REPLACE_WITH_A_LONG_SECRET

# TUN address; its network is where the clients' IPs live.
GOPROXY_TUN_ADDRESS=10.8.0.1/24

# NAT the clients (the TUN network) to the internet out of this interface
# (eth0 inside the container; the real uplink with network_mode: host).
GOPROXY_MASQUERADE=eth0
GOPROXY_MTU=1380

# Self-signed cert host for tls mode (clients set GOPROXY_TLS_INSECURE=true).
GOPROXY_TLS_HOST=www.microsoft.com

# Clients: one GOPROXY_PEER_<NAME> (public key) each, with the tunnel IP it is
# handed. <NAME> is a label without '_'.
GOPROXY_PEER_LAPTOP=REPLACE_WITH_CLIENT_PUBLIC_KEY
GOPROXY_PEER_LAPTOP_IP=10.8.0.2
# GOPROXY_PEER_PHONE=REPLACE_WITH_CLIENT_PUBLIC_KEY
# GOPROXY_PEER_PHONE_IP=10.8.0.3

# Fallback for connections that fail the handshake (scanners and active DPI
# probing). Instead of hanging/closing (a proxy tell), the node behaves like a
# normal web server. Modes: off | status | redirect | proxy.
#   status:   return a fixed HTTP status (looks like an nginx page)
#   redirect: 302 to GOPROXY_FALLBACK_URL
#   proxy:    transparently reverse-proxy to GOPROXY_FALLBACK_TARGET (strongest
#             camouflage — point it at a local nginx or a real site's host:port)
GOPROXY_FALLBACK_MODE=proxy
GOPROXY_FALLBACK_TARGET=127.0.0.1:8080
# GOPROXY_FALLBACK_STATUS=403
# GOPROXY_FALLBACK_URL=https://example.org/
