# Copy to server.env and fill in. All values are environment variables.
# Generate keys with:  goproxy keypair   (or genkey | pubkey)

GOPROXY_TRANSPORT=tls
GOPROXY_LISTEN=0.0.0.0:443

# This server's static private key (base64).
GOPROXY_PRIVATE_KEY=REPLACE_WITH_SERVER_PRIVATE_KEY

# Shared secret; must match every client.
GOPROXY_PSK=REPLACE_WITH_A_LONG_SECRET

GOPROXY_TUNNEL_SUBNET=10.8.0.0/24
GOPROXY_TUNNEL_SERVER_IP=10.8.0.1
GOPROXY_MTU=1380

# Self-signed cert host for tls mode (clients set GOPROXY_TLS_INSECURE=true).
GOPROXY_TLS_HOST=www.microsoft.com

# Enable IP forwarding + MASQUERADE inside the container (reverted on shutdown).
GOPROXY_AUTO_NAT=true

# Authorized clients: one GOPROXY_CLIENT_<NAME> per client, value is
# "pubkey,ip[,allowed_ips]" (allowed_ips space-separated). The <NAME> is a label.
GOPROXY_CLIENT_LAPTOP=REPLACE_WITH_CLIENT_PUBLIC_KEY,10.8.0.2
# GOPROXY_CLIENT_PHONE=REPLACE_WITH_CLIENT_PUBLIC_KEY,10.8.0.3,192.168.50.0/24

# Fallback for connections that fail the client handshake (scanners and active
# DPI probing). Instead of hanging/closing (a proxy tell), the server behaves
# like a normal web server. Modes: off | status | redirect | proxy.
#   status:   return a fixed HTTP status (looks like an nginx page)
#   redirect: 302 to GOPROXY_FALLBACK_URL
#   proxy:    transparently reverse-proxy to GOPROXY_FALLBACK_TARGET (strongest
#             camouflage — point it at a local nginx or a real site's host:port)
GOPROXY_FALLBACK_MODE=proxy
GOPROXY_FALLBACK_TARGET=127.0.0.1:8080
# GOPROXY_FALLBACK_STATUS=403
# GOPROXY_FALLBACK_URL=https://example.org/
