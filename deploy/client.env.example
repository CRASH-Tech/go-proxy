# Client node: connects to one or more exit nodes. Copy to client.env and fill in.
# Each packet entering the TUN goes to the peer whose _ROUTES contain its
# destination (longest prefix wins); everything else is BLOCKED. What enters
# the TUN is up to the host's routing (README: "client host setup"). Each peer
# is GOPROXY_PEER_<NAME> (its public key) with GOPROXY_PEER_<NAME>_<FIELD>
# settings; unset fields fall back to the global GOPROXY_* defaults below.

GOPROXY_TRANSPORT=tls                       # default transport for all peers
GOPROXY_PSK=REPLACE_WITH_A_LONG_SECRET      # default; must match the exit node(s)
GOPROXY_PRIVATE_KEY=REPLACE_WITH_CLIENT_PRIVATE_KEY  # this node's static key
GOPROXY_TLS_SNI=www.microsoft.com
GOPROXY_TLS_INSECURE=true                   # accept self-signed certs
GOPROXY_MTU=1380

# GOPROXY_IFNAME=goproxy0                   # TUN name
# GOPROXY_FWMARK=0x676f                     # mark of the node's own connections

# --- Peer EXIT: everything not routed to another peer ---
GOPROXY_PEER_EXIT=REPLACE_WITH_EXIT_PUBLIC_KEY
GOPROXY_PEER_EXIT_ENDPOINT=EXIT_PUBLIC_IP:443
GOPROXY_PEER_EXIT_ROUTES=0.0.0.0/0

# --- Optional second exit, only for specific destinations ---
# GOPROXY_PEER_US=...
# GOPROXY_PEER_US_ENDPOINT=us.example:443
# GOPROXY_PEER_US_TRANSPORT=udp             # per-peer override
# GOPROXY_PEER_US_ROUTES=203.0.113.0/24 198.51.100.7/32
