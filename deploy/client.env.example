# Copy to client.env and fill in. All values are environment variables.
# The client connects to one or more servers; each is GOPROXY_SERVER_<NAME>
# with optional GOPROXY_SERVER_<NAME>_<FIELD> overrides. Unset fields fall back
# to the global GOPROXY_* defaults below.

GOPROXY_TRANSPORT=tls                       # default transport for all servers
GOPROXY_PSK=REPLACE_WITH_A_LONG_SECRET      # default; must match the server(s)
GOPROXY_PRIVATE_KEY=REPLACE_WITH_CLIENT_PRIVATE_KEY  # this client's static key
GOPROXY_TLS_SNI=www.microsoft.com
GOPROXY_TLS_INSECURE=true                   # accept self-signed server certs
GOPROXY_MTU=1380

# --- Server MAIN: carries all traffic by default ---
GOPROXY_SERVER_MAIN=SERVER_PUBLIC_IP:443
GOPROXY_SERVER_MAIN_PUBLIC_KEY=REPLACE_WITH_SERVER_PUBLIC_KEY
GOPROXY_SERVER_MAIN_DEFAULT=true            # route this host's traffic via it
GOPROXY_SERVER_MAIN_IFNAME=tun-main
# Keep your LAN off the tunnel so the host stays reachable from other subnets:
# GOPROXY_SERVER_MAIN_EXCLUDE=192.168.0.0/16 10.0.0.0/8
# GOPROXY_SERVER_MAIN_GATEWAY=true          # masquerade LAN traffic into it

# --- Optional second server, only for specific destinations ---
# GOPROXY_SERVER_US=us.example:443
# GOPROXY_SERVER_US_PUBLIC_KEY=...
# GOPROXY_SERVER_US_TRANSPORT=udp           # per-server override
# GOPROXY_SERVER_US_ROUTES=203.0.113.0/24 198.51.100.7/32
# GOPROXY_SERVER_US_IFNAME=tun-us
